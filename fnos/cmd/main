#!/bin/bash
set -u
LOG_FILE="${TRIM_PKGVAR}/f2media-service.log"
PID_FILE="${TRIM_PKGVAR}/f2media.pid"
APP_CMD="${TRIM_APPDEST}/bin/start-f2media"
mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true
is_running() {
  [ -r "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE" 2>/dev/null)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}
case "${1:-}" in
  start)
    if is_running; then exit 0; fi
    export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    cd "${TRIM_PKGVAR}" || exit 1
    "$APP_CMD" "${TRIM_PKGVAR}" >>"$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    sleep 2
    if ! is_running; then
      message="F2Media failed to start; see $LOG_FILE"
      echo "$message" >&2
      if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$message" > "$TRIM_TEMP_LOGFILE" 2>/dev/null || true
        tail -n 30 "$LOG_FILE" >> "$TRIM_TEMP_LOGFILE" 2>/dev/null || true
      fi
      tail -n 80 "$LOG_FILE" >&2 2>/dev/null || true
      rm -f "$PID_FILE"
      exit 1
    fi
    ;;
  stop)
    if is_running; then
      pid="$(cat "$PID_FILE")"; kill -TERM "$pid" 2>/dev/null || true
      i=0; while kill -0 "$pid" 2>/dev/null && [ $i -lt 20 ]; do sleep 1; i=$((i+1)); done
      kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
    ;;
  status)
    is_running && exit 0 || exit 3
    ;;
  log)
    tail -n "${2:-200}" "$LOG_FILE" 2>/dev/null || true
    ;;
  *) exit 1 ;;
esac
exit 0
